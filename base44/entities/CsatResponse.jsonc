{
  "name": "CsatResponse",
  "type": "object",
  "properties": {
    "ticket_id": {
      "type": "string",
      "description": "Reference to Ticket id"
    },
    "ticket_display_id": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "description": "1-5 star rating"
    },
    "comment": {
      "type": "string"
    },
    "respondent_id": {
      "type": "string"
    },
    "respondent_name": {
      "type": "string"
    },
    "agent_name": {
      "type": "string",
      "description": "Agent who resolved the ticket"
    },
    "department": {
      "type": "string"
    },
    "category": {
      "type": "string"
    }
  },
  "required": [
    "ticket_id",
    "rating"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "agent"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
