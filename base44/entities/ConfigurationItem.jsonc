{
  "name": "ConfigurationItem",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "ci_type": {
      "type": "string",
      "enum": [
        "server",
        "application",
        "database",
        "network_device",
        "cloud_resource",
        "sap_system",
        "m365_service",
        "end_user_device",
        "storage"
      ]
    },
    "environment": {
      "type": "string",
      "enum": [
        "production",
        "test",
        "development"
      ],
      "default": "production"
    },
    "status": {
      "type": "string",
      "enum": [
        "operational",
        "degraded",
        "down",
        "maintenance",
        "retired"
      ],
      "default": "operational"
    },
    "owner_team": {
      "type": "string",
      "description": "IT team responsible for this CI"
    },
    "hostname": {
      "type": "string"
    },
    "ip_address": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "dependencies": {
      "type": "string",
      "description": "Comma-separated CI ids this item depends on"
    },
    "related_asset_tag": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "ci_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "agent"
          }
        }
      ]
    },
    "read": true,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "agent"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
