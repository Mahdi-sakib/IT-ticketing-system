{
  "name": "Asset",
  "type": "object",
  "properties": {
    "asset_tag": {
      "type": "string",
      "description": "Unique asset tag e.g. AST-000123"
    },
    "name": {
      "type": "string",
      "description": "Friendly asset name"
    },
    "type": {
      "type": "string",
      "enum": [
        "laptop",
        "desktop",
        "monitor",
        "phone",
        "printer",
        "server",
        "network_device",
        "mobile",
        "peripheral",
        "software_license"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "procurement",
        "in_stock",
        "deployed",
        "in_maintenance",
        "in_repair",
        "reassigned",
        "retired",
        "disposed"
      ],
      "default": "in_stock"
    },
    "manufacturer": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "serial_number": {
      "type": "string"
    },
    "purchase_date": {
      "type": "string",
      "format": "date"
    },
    "purchase_cost": {
      "type": "number",
      "description": "Purchase cost in local currency"
    },
    "warranty_end": {
      "type": "string",
      "format": "date"
    },
    "vendor": {
      "type": "string"
    },
    "assigned_to_id": {
      "type": "string",
      "description": "User id of current holder"
    },
    "assigned_to_name": {
      "type": "string"
    },
    "previous_holders": {
      "type": "string",
      "description": "Comma-separated names of previous holders"
    },
    "location": {
      "type": "string"
    },
    "department": {
      "type": "string"
    },
    "maintenance_history": {
      "type": "string",
      "description": "Notes about maintenance events"
    },
    "depreciation_percent": {
      "type": "number",
      "description": "Current depreciated value percent of purchase cost"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "asset_tag",
    "name",
    "type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "agent"
          }
        }
      ]
    },
    "read": true,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "agent"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
